{
  "$schema": "https://arisen.dev/schemas/package-v2.json",
  "id": "com.arisen.app",
  "name": "Arisen Application Shell",
  "version": "1.0.0",
  "engine": {
    "minVersion": "0.1.0"
  },
  "layer": "domain",
  "author": "Arisen Team",
  "description": "The application shell every product depends on: it activates the process's startup target - selected with --startup-* or declared by the workspace manifest - and owns the interactive runtime viewer.",
  "type": "managed",
  "entry": {
    "assembly": "Com.Arisen.App.dll",
    "class": "ArisenEngine.App.ApplicationShellPackage"
  },
  "services": {
    "requires": [
      "ArisenEngine.Resources.Serialization.IRuntimeSceneService",
      "ArisenEngine.Resources.Serialization.IRuntimeWorldStreamingService",
      "ArisenEngine.Resources.Serialization.IWorldOriginService",
      "ArisenEngine.Resources.Serialization.ISampleCatalogueService"
    ]
  },
  "dependencies": {
    "com.arisen.core": "1.0.0",
    "com.arisen.ecs": "1.0.0",
    "com.arisen.resources": "1.0.0"
  },
  "subsystems": [
    {
      "class": "ArisenEngine.App.StartupTargetBootstrapSubsystem",
      "phase": "PostInit",
      "priority": 50
    },
    {
      "class": "ArisenEngine.App.RuntimeCameraNavigationSubsystem",
      "phase": "Running",
      "priority": 60
    }
  ]
}
